{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "reply": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "say": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "fromRecords": {
      "maxItems": 2,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "what": {
            "type": "string",
            "minLength": 1,
            "maxLength": 140
          },
          "link": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "source": {
            "type": "string",
            "enum": [
              "알림장",
              "관찰",
              "검진",
              "가족기록"
            ]
          }
        },
        "required": [
          "date",
          "what",
          "link",
          "source"
        ],
        "additionalProperties": false
      }
    },
    "evidence": {
      "maxItems": 2,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "point": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "ref",
          "point"
        ],
        "additionalProperties": false
      }
    },
    "cardUpdate": {
      "type": "object",
      "properties": {
        "needed": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "maxLength": 160
        }
      },
      "required": [
        "needed",
        "reason"
      ],
      "additionalProperties": false
    },
    "limits": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    }
  },
  "required": [
    "reply",
    "fromRecords",
    "evidence",
    "cardUpdate"
  ],
  "additionalProperties": false
}
