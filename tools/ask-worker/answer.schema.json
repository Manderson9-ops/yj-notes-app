{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AskAnswer",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "level",
    "levelTitle",
    "levelReason",
    "summary",
    "fromRecords",
    "evidence",
    "tryNow",
    "avoid",
    "observe",
    "upIf",
    "downIf"
  ],
  "properties": {
    "level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "levelTitle": {
      "type": "string",
      "maxLength": 600
    },
    "levelReason": {
      "type": "string",
      "maxLength": 600
    },
    "summary": {
      "type": "string",
      "maxLength": 600
    },
    "fromRecords": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "what", "source"],
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "maxLength": 600
          },
          "what": {
            "type": "string",
            "maxLength": 600
          },
          "source": {
            "type": "string",
            "enum": ["알림장", "관찰", "검진", "가족기록"]
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "point"],
        "properties": {
          "ref": {
            "type": "string",
            "maxLength": 600
          },
          "point": {
            "type": "string",
            "maxLength": 600
          },
          "grade": {
            "type": "string",
            "maxLength": 600
          }
        }
      }
    },
    "tryNow": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action"],
        "properties": {
          "action": {
            "type": "string",
            "maxLength": 600
          },
          "say": {
            "type": "string",
            "maxLength": 600
          }
        }
      }
    },
    "avoid": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "string",
        "maxLength": 600
      }
    },
    "observe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["what", "howLong", "how"],
      "properties": {
        "what": {
          "type": "string",
          "maxLength": 600
        },
        "howLong": {
          "type": "string",
          "maxLength": 600
        },
        "how": {
          "type": "string",
          "maxLength": 600
        }
      }
    },
    "upIf": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "string",
        "maxLength": 600
      }
    },
    "downIf": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "string",
        "maxLength": 600
      }
    },
    "forAsker": {
      "type": "string",
      "maxLength": 600
    },
    "limits": {
      "type": "string",
      "maxLength": 600
    }
  }
}
