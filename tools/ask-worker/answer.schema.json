{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "levelTitle": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "levelReason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "fromRecords": {
      "maxItems": 6,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "what": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "source": {
            "type": "string",
            "enum": [
              "알림장",
              "관찰",
              "검진",
              "가족기록"
            ]
          }
        },
        "required": [
          "date",
          "what",
          "source"
        ],
        "additionalProperties": false
      }
    },
    "evidence": {
      "minItems": 1,
      "maxItems": 6,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "point": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "grade": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          }
        },
        "required": [
          "ref",
          "point"
        ],
        "additionalProperties": false
      }
    },
    "tryNow": {
      "minItems": 2,
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "say": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          }
        },
        "required": [
          "action"
        ],
        "additionalProperties": false
      }
    },
    "avoid": {
      "minItems": 1,
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 600
      }
    },
    "observe": {
      "type": "object",
      "properties": {
        "what": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "howLong": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "how": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        }
      },
      "required": [
        "what",
        "howLong",
        "how"
      ],
      "additionalProperties": false
    },
    "upIf": {
      "minItems": 1,
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 600
      }
    },
    "downIf": {
      "minItems": 1,
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 600
      }
    },
    "forAsker": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "limits": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    }
  },
  "required": [
    "level",
    "levelTitle",
    "levelReason",
    "summary",
    "fromRecords",
    "evidence",
    "tryNow",
    "avoid",
    "observe",
    "upIf",
    "downIf"
  ],
  "additionalProperties": false
}
